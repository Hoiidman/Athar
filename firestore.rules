rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function userFields() {
      return ['displayName', 'photoUrl', 'familyCircleId', 'createdAt', 'updatedAt'];
    }

    function isValidUser(data) {
      return data.keys().hasOnly(userFields())
        && data.keys().hasAll(userFields())
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && (data.photoUrl == null || data.photoUrl is string)
        && (data.familyCircleId == null || data.familyCircleId is string);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);

      allow list: if false;

      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
