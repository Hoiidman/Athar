rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function inCircle(circleId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/familyCircles/$(circleId)/members/$(request.auth.uid));
    }

    function userFields() {
      return ['displayName', 'photoUrl', 'familyCircleId', 'createdAt', 'updatedAt'];
    }

    function isValidUser(data) {
      return data.keys().hasOnly(userFields())
        && data.keys().hasAll(userFields())
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && (data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && (data.familyCircleId == null
          || (data.familyCircleId is string && data.familyCircleId.size() <= 128));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);

      allow list: if false;

      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function circleFields() {
      return ['name', 'inviteCode', 'ownerId', 'memberIds', 'createdAt', 'updatedAt'];
    }

    function isValidCircle(data) {
      return data.keys().hasOnly(circleFields())
        && data.keys().hasAll(circleFields())
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.inviteCode is string
        && data.inviteCode.size() <= 16
        && data.ownerId is string
        && data.memberIds is list
        && data.memberIds.size() <= 50;
    }

    function memberFields() {
      return ['userId', 'displayName', 'role', 'inviteCodeUsed', 'joinedAt'];
    }

    // Optional so member documents written before this field existed still
    // validate when they are updated — an update is checked against the
    // merged document, which would otherwise be missing the key.
    function memberOptionalFields() {
      return ['relationship'];
    }

    function isValidMember(data) {
      return data.keys().hasAll(memberFields())
        && data.keys().hasOnly(memberFields().concat(memberOptionalFields()))
        && data.userId is string
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && (!data.keys().hasAny(['relationship'])
          || data.relationship == null
          || (data.relationship is string && data.relationship.size() <= 40));
    }

    match /familyCircles/{circleId} {

      function isMember() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/familyCircles/$(circleId)/members/$(request.auth.uid));
      }

      function isRename() {
        return resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.updatedAt == request.time;
      }

      function isRotateCode() {
        return resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteCode', 'updatedAt'])
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() <= 16
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.familyCircleId == circleId;
      }

      function isJoin() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/familyCircles/$(circleId)/members/$(request.auth.uid)).data.inviteCodeUsed is string;
      }

      function isEvict() {
        return resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.updatedAt == request.time;
      }

      function isLeave() {
        return resource.data.ownerId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
          && request.auth.uid in resource.data.memberIds
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          && request.resource.data.updatedAt == request.time
          && !existsAfter(/databases/$(database)/documents/familyCircles/$(circleId)/members/$(request.auth.uid));
      }

      allow get: if isMember();

      allow list: if false;

      allow create: if isSignedIn()
        && isValidCircle(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/familyCircles/$(circleId)/members/$(request.auth.uid)).data.role == 'owner';

      allow update: if isSignedIn()
        && isValidCircle(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && (isRename() || isJoin() || isRotateCode() || isLeave() || isEvict());

      allow delete: if false;

      match /members/{userId} {

        function isCircleOwner() {
          return isSignedIn()
            && get(/databases/$(database)/documents/familyCircles/$(circleId)).data.ownerId
              == request.auth.uid;
        }

        function changesOnly(fields) {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
        }

        function isFoundingOwner() {
          return request.resource.data.role == 'owner'
            && request.resource.data.inviteCodeUsed == null
            && getAfter(/databases/$(database)/documents/familyCircles/$(circleId)).data.ownerId == request.auth.uid;
        }

        function knowsInviteCode() {
          return request.resource.data.role == 'member'
            && request.resource.data.inviteCodeUsed is string
            && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCodeUsed))
            && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCodeUsed)).data.familyCircleId == circleId;
        }

        allow get, list: if isSignedIn()
          && exists(/databases/$(database)/documents/familyCircles/$(circleId)/members/$(request.auth.uid));

        allow create: if isOwner(userId)
          && isValidMember(request.resource.data)
          && request.resource.data.userId == userId
          && request.resource.data.joinedAt == request.time
          && (isFoundingOwner() || knowsInviteCode());

        allow update: if isValidMember(request.resource.data)
          && (
            (isOwner(userId) && changesOnly(['displayName', 'relationship']))
            || (isCircleOwner() && changesOnly(['relationship']))
          );

        // The circle owner is excluded: dropping their own membership would
        // leave a circle nobody can administer and a name nobody can change.
        allow delete: if (isOwner(userId) && !isCircleOwner())
          || (isCircleOwner() && userId != request.auth.uid);
      }
    }

    function inviteCodeFields() {
      return ['familyCircleId', 'createdBy', 'createdAt'];
    }

    match /inviteCodes/{code} {
      allow get: if isSignedIn();

      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(inviteCodeFields())
        && request.resource.data.keys().hasAll(inviteCodeFields())
        && request.resource.data.familyCircleId is string
        && request.resource.data.familyCircleId.size() <= 128
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/familyCircles/$(request.resource.data.familyCircleId)).data.ownerId == request.auth.uid;

      allow update: if false;

      // Only as part of a rotation: the circle must already point somewhere
      // else once the write lands, so an owner cannot strand their circle
      // with a code nobody can look up.
      allow delete: if isSignedIn()
        && get(/databases/$(database)/documents/familyCircles/$(resource.data.familyCircleId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/familyCircles/$(resource.data.familyCircleId)).data.inviteCode != code;
    }

    function memoryGroupFields() {
      return ['familyCircleId', 'title', 'category', 'startDate', 'endDate', 'memberIds',
              'coverPhotoUrl', 'createdBy', 'createdAt', 'updatedAt'];
    }

    function isValidMemoryGroup(data) {
      return data.keys().hasOnly(memoryGroupFields())
        && data.keys().hasAll(['familyCircleId', 'title', 'startDate', 'endDate', 'memberIds', 'createdBy', 'createdAt', 'updatedAt'])
        && data.familyCircleId is string
        && data.familyCircleId.size() <= 128
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && (!('category' in data) || data.category in ['vacation', 'event', 'holiday', 'other'])
        && data.startDate is timestamp
        && data.endDate is timestamp
        && data.startDate <= data.endDate
        && data.memberIds is list
        && data.memberIds.size() > 0
        && data.memberIds.size() <= 50
        && (data.coverPhotoUrl == null
          || (data.coverPhotoUrl is string && data.coverPhotoUrl.size() <= 500))
        && data.createdBy is string;
    }

    match /memoryGroups/{groupId} {
      allow get, list: if inCircle(resource.data.familyCircleId);

      allow create: if isValidMemoryGroup(request.resource.data)
        && inCircle(request.resource.data.familyCircleId)
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isValidMemoryGroup(request.resource.data)
        && inCircle(resource.data.familyCircleId)
        && request.resource.data.familyCircleId == resource.data.familyCircleId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function memoryFields() {
      return ['familyCircleId', 'memoryGroupId', 'visibility', 'type', 'storageUrl',
              'thumbnailUrl', 'durationSeconds', 'takenAt', 'uploadedBy', 'caption',
              'transcript', 'aiStory', 'aiStatus', 'categorizationMethod', 'includeInSlideshow',
              'createdAt', 'updatedAt'];
    }

    function isValidMemory(data) {
      return data.keys().hasOnly(memoryFields())
        && data.keys().hasAll(memoryFields())
        && data.familyCircleId is string
        && data.memoryGroupId is string
        && data.visibility in ['private', 'shared']
        && (
             (data.visibility == 'private' && data.memoryGroupId == 'my-space')
             || (data.visibility == 'shared' && data.memoryGroupId != 'my-space')
           )
        && data.type in ['photo', 'video', 'voice']
        && data.storageUrl is string
        && (data.thumbnailUrl == null || data.thumbnailUrl is string)
        && (data.durationSeconds == null || data.durationSeconds is number)
        && (data.takenAt == null || data.takenAt is timestamp)
        && data.uploadedBy is string
        && (data.caption == null || data.caption is string)
        && (data.transcript == null || data.transcript is string)
        && (data.aiStory == null || data.aiStory is string)
        && data.aiStatus in ['pending', 'success', 'failed', 'offline_fallback', 'not_applicable']
        && data.categorizationMethod in ['auto', 'manual', 'default']
        && data.includeInSlideshow is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /memories/{memoryId} {
      allow get, list: if isSignedIn() 
        && (
          (inCircle(resource.data.familyCircleId) && resource.data.visibility == 'shared')
          || resource.data.uploadedBy == request.auth.uid
        );

      allow create: if isSignedIn()
        && isValidMemory(request.resource.data)
        && inCircle(request.resource.data.familyCircleId)
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        // Clients cannot set AI fields
        && request.resource.data.aiStory == null
        && request.resource.data.aiStatus in ['pending', 'not_applicable'];

      allow update: if isSignedIn()
        && isValidMemory(request.resource.data)
        && inCircle(resource.data.familyCircleId)
        && request.resource.data.familyCircleId == resource.data.familyCircleId
        && request.resource.data.uploadedBy == resource.data.uploadedBy
        && request.auth.uid == resource.data.uploadedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        // Clients cannot modify AI fields
        && request.resource.data.aiStory == resource.data.aiStory
        && request.resource.data.aiStatus == resource.data.aiStatus;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
