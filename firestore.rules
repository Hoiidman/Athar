rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny. Real rules are built out per collection in Phase 1
    // (users, familyCircles) and Phase 3 (memoryGroups, memories) —
    // see Database_Schema.md for the intended access model.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
